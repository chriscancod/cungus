<!-- Added 2026-09-08 — rotation 1 branding audit, item #9. Only lists real
     static pages. Product pages (product.html?id=...) are populated at
     runtime from the live Printify catalog via fetch, not static files —
     enumerating them here would mean hardcoding IDs that go stale the
     moment a product is added/removed/re-tagged. If product-page SEO
     matters later, the right fix is a small backend endpoint that generates
     this file dynamically from the live catalog, not hand-maintaining it. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://2amcases.online/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://2amcases.online/catalog.html</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://2amcases.online/about.html</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <!-- Added 2026-09-09 (rotation 1, items #1/#2/#5/#6). services and faq are
       real content pages people search for and land on directly, so they get
       meaningfully higher priority than the pure-legal pages below. refunds
       sits between the two — it's a legal page, but "returns policy" is a
       genuine pre-purchase search, so it isn't buried at 0.2. -->
  <url>
