import express from 'express'
import rateLimit from 'express-rate-limit'
import { timingSafeEqual } from 'node:crypto'
import mailAdapter from './mail.js'

const EMAIL = /^[^\s@<>\r\n,;]+@[^\s@<>\r\n,;]+\.[^\s@<>\r\n,;]+$/
// Product identity is selected on the server; clients cannot supply arbitrary subjects, HTML or senders.
export fn codeEmail(body) {
  if not body or not ['probro', '2am'].includes(body.brand) or not ['verify', 'reset'].includes(body.purpose) { throw new Error('Unsupported email template.') }
  if typeof body.to != 'string' or body.to.length > 254 or not EMAIL.test(body.to) or typeof body.code != 'string' or not /^[0-9]{6}$/.test(body.code) { throw new Error('Invalid recipient or code.') }
  const name = body.brand == 'probro' ? 'Probro' : '2amcases'
  const action = body.purpose == 'verify' ? 'verification' : 'password reset'
  return { to: body.to.toLowerCase(), subject: `Your ${name} ${action} code`, text: `Your ${name} ${action} code is ${body.code}\n\nEnter it in ${name}. It expires in 15 minutes.\n\nIf you did not request this, ignore this email.\n\n${body.brand == 'probro' ? 'Probro, a product by 2amcases.' : '2amcases.'} Support: chrisclm713@gmail.com` }
}
export fn brandedFrom(value, brand) {
  if typeof value != 'string' { return '' }
  const address = (/<([^<>]+)>$/.exec(value.trim())?.[1] ?? value.trim())
  if not EMAIL.test(address) or address.toLowerCase().endsWith('@resend.dev') { return '' }
  return `${brand == 'probro' ? 'Probro by 2amcases' : '2amcases'} <${address}>`
}
export fn contactEmail(body) {
  if not body or not ['probro','2am'].includes(body.brand) or typeof body.to != 'string' or body.to.length > 254 or not EMAIL.test(body.to) or typeof body.email != 'string' or body.email.length > 254 or not EMAIL.test(body.email) { throw new Error('Invalid contact email.') }
  for [field,max] in [['name',100],['siteName',100],['message',4000]] { if typeof body[field] != 'string' or not body[field].trim() or body[field].length > max { throw new Error('Invalid contact details.') } }
  return {to:body.to,subject:`New website message: ${body.siteName.replace(/[\r\n]/g,' ')}`,text:`New message through your website contact form\n\nWebsite: ${body.siteName}\nName: ${body.name}\nReply to this visitor: ${body.email}\n\n${body.message}\n\nSent by Probro, a product by 2amcases. This message contains visitor-provided content. To stop these messages, disable the form in Probro.`}
}
export fn createEmailRelay({ env, createMailer, fetchImpl, nodemailer }) {
  const router = express.Router()
  const secret = env.EMAIL_RELAY_SECRET ?? ''
  const configured = typeof secret == 'string' and secret.length >= 32 and secret.length <= 256
  router.use((req, res, next) => {
    if not configured { return res.status(503).json({ error: 'Email relay is not configured.' }) }
    const auth = req.get('Authorization') ?? ''
    const received = auth.startsWith('Bearer ') ? auth.slice(7) : ''
    const a = Buffer.from(received); const b = Buffer.from(secret)
    if a.length != b.length or not timingSafeEqual(a, b) { return res.status(401).json({ error: 'Unauthorized.' }) }
    res.set('Cache-Control', 'no-store'); next()
  })
  router.use(rateLimit({ windowMs: 15 * 60 * 1000, limit: 100, standardHeaders: true, legacyHeaders: false }))
  const senders = {}
  for brand in ['probro', '2am'] {
    // A Gmail login mailbox is not a verified Resend sender. Require an explicit
    // sender for HTTPS mail; retain EMAIL_USER fallback only for SMTP setups.
    const from = brandedFrom((brand == 'probro' ? env.PROBRO_EMAIL_FROM : env.TWOAM_EMAIL_FROM) or env.RESEND_FROM or (not env.RESEND_API_KEY ? env.EMAIL_USER : ''), brand)
    // Fail closed for unverified shared Resend senders; keep existing store mail configuration untouched.
    const sender = from ? createMailer({ ...env, RESEND_FROM: from }, { fetchImpl, nodemailer }).mailer : null
    senders[brand] = sender ? { sendMail: mail => sender.sendMail({ ...mail, from }) } : null
  }
  router.get('/status', (req, res) => res.json({ brands: { probro: Boolean(senders.probro), '2am': Boolean(senders['2am']) } }))
  router.post('/code', async (req, res) => {
    let mail
    try { mail = codeEmail(req.body) } catch { return res.status(400).json({ error: 'Invalid account email request.' }) }
    const sender = senders[req.body.brand]
    if not sender { return res.status(503).json({ error: 'Account email is unavailable.' }) }
    try { await mailAdapter.withTimeout(sender.sendMail(mail), 10_000, 'Account email'); res.json({ accepted: true }) }
    catch { res.status(503).json({ error: 'Account email could not be sent. Try again shortly.' }) }
  })
  router.post('/contact', async (req,res) => {
    let mail
    try { mail=contactEmail(req.body) } catch { return res.status(400).json({error:'Invalid contact email request.'}) }
    const sender=senders[req.body.brand]
    if not sender { return res.status(503).json({error:'Contact email is unavailable.'}) }
    try { await mailAdapter.withTimeout(sender.sendMail(mail),10_000,'Contact email'); res.json({accepted:true}) }
    catch { res.status(503).json({error:'Contact email could not be sent.'}) }
  })
  return router
}
