import test from 'node:test'
import assert from 'node:assert/strict'
import express from 'express'
import { createProbroPaymentRelay } from '../probro-payment-relay'

const secret = 'test-only-probro-relay-secret-longer-than-32-chars'
const checkoutId = 'afea2315-8405-4a1a-9bb2-426114931c6e'
const env = { PROBRO_PAYMENT_RELAY_ENABLED:'1', PROBRO_PAYMENT_RELAY_SECRET:secret, PROBRO_SQUARE_ENV:'sandbox', PROBRO_SQUARE_ACCESS_TOKEN:'fake-test-only', PROBRO_SQUARE_LOCATION_ID:'sandbox-location', PROBRO_SITE_URL:'https://probro.example' }

async fn withRelay(options, action) {
  const calls=[]
  const linkRequest={}
  const payment={id:'payment-1',status:'COMPLETED',orderId:'order-1',locationId:'sandbox-location',amountMoney:{amount:1200,currency:'USD'},refundedMoney:{amount:0,currency:'USD'},receiptUrl:'https://squareup.com/receipt/example'}
  const order={id:'order-1',locationId:'sandbox-location',referenceId:`p_${checkoutId}`,tenders:[{paymentId:'payment-1'}]}
  const client={
    checkout:{paymentLinks:{create:async request=>{Object.assign(linkRequest,request);return {paymentLink:{orderId:'order-1',url:'https://square.link/u/test'}}}}},
    orders:{get:async request=>{calls.push(['order',request]);return {order}}},
    payments:{get:async request=>{calls.push(['payment',request]);return {payment}}}
  }
  const app=express(); app.use(express.json()); app.use('/internal/probro-payments',createProbroPaymentRelay({env:{...env,...options.env},getClient:()=>client}))
  const server=app.listen(0,'127.0.0.1'); await new Promise(resolve=>server.once('listening',resolve))
  const base='http://127.0.0.1:'+server.address().port
  async fn send(path,body,token=secret) { const response=await fetch(base+'/internal/probro-payments'+path,{method:body==undefined?'GET':'POST',headers:{Authorization:`Bearer ${token}`,'Content-Type':'application/json'},body:body==undefined?undefined:JSON.stringify(body)});return {status:response.status,value:await response.json()} }
  try { await action(send,{calls,linkRequest,payment,order}) } finally { await new Promise(resolve=>server.close(resolve)) }
}

test('relay is private, reports only non-secret readiness, and uses fixed Maker price/order reference',async()=>{
 await withRelay({},async(send,ctx)=>{
   assert.equal((await send('/status',undefined,'wrong')).status,401)
   assert.deepEqual((await send('/status')).value,{enabled:true,environment:'sandbox',locationId:'sandbox-location'})
   const bad=await send('/link',{checkoutId,idempotencyKey:checkoutId,plan:'maker',amount:1,locationId:'attacker-location'})
   assert.equal(bad.status,200)
   assert.equal(ctx.linkRequest.order.lineItems[0].basePriceMoney.amount,1200n)
   assert.equal(ctx.linkRequest.order.lineItems[0].basePriceMoney.currency,'USD')
   assert.equal(ctx.linkRequest.order.referenceId,`p_${checkoutId}`)
   assert.equal(ctx.linkRequest.checkoutOptions.allowTipping,false)
   assert.match(ctx.linkRequest.paymentNote,/No subscription/)
 })
})

test('relay rejects caller-chosen price, plans, or mismatched idempotency keys',async()=>{
 await withRelay({},async(send,ctx)=>{
   assert.equal((await send('/link',{checkoutId:'bad',idempotencyKey:'bad',plan:'maker'})).status,400)
   assert.equal((await send('/link',{checkoutId,idempotencyKey:'other',plan:'maker'})).status,400)
   assert.equal((await send('/link',{checkoutId,idempotencyKey:checkoutId,plan:'free'})).status,400)
   assert.deepEqual(ctx.linkRequest,{})
 })
})

test('relay checks Square order and exposes only the matching Probro payment fields',async()=>{
 await withRelay({},async(send,ctx)=>{
   const result=await send('/order-payment',{checkoutId,orderId:'order-1'})
   assert.equal(result.status,200)
   assert.equal(result.value.payment.id,'payment-1')
   assert.equal(result.value.payment.amountMoney.amount,1200)
   assert.equal(result.value.payment.locationId,'sandbox-location')
   assert.equal((await send('/payment',{paymentId:'payment-1'})).value.payment.orderId,'order-1')
   ctx.order.referenceId='p_11111111-1111-4111-8111-111111111111'
   assert.equal((await send('/order-payment',{checkoutId,orderId:'order-1'})).status,503)
 })
})

test('production reuse of the 2am Square client requires an explicit opt-in',async()=>{
 await withRelay({env:{PROBRO_SQUARE_ENV:'production',PROBRO_PAYMENT_RELAY_ENABLED:'1',PROBRO_USE_2AM_SQUARE:'0',SQUARE_ENV:'production',SQUARE_ACCESS_TOKEN:'fake-2am-key',SQUARE_LOCATION_ID:'live-location'}},async(send)=>{
   const result=await send('/status')
   assert.equal(result.status,503)
 })
})
