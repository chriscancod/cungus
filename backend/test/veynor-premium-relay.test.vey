import test from 'node:test'
import assert from 'node:assert/strict'
import express from 'express'
import { createVeynorPremiumRelay } from '../veynor-premium-relay'

const secret = 'test-only-veynor-premium-relay-secret-longer-than-32-chars'
const checkoutId = 'afea2315-8405-4a1a-9bb2-426114931c6e'
const env = {VEYNOR_PREMIUM_RELAY_ENABLED:'1',VEYNOR_PREMIUM_RELAY_SECRET:secret,VEYNOR_PREMIUM_SQUARE_ENV:'sandbox',VEYNOR_PREMIUM_SQUARE_ACCESS_TOKEN:'test-fake',VEYNOR_PREMIUM_SQUARE_LOCATION_ID:'test-location',VEYNOR_PLUS_MONTHLY_VARIATION_ID:'variation-1',VEYNOR_PLUS_MONTHLY_AMOUNT_CENTS:'499',VEYNOR_PLUS_RETURN_URL:'https://veynor.example/settings'}

async fn withRelay(options, action) {
  const calls=[]; const linkRequest={}
  const catalogAmount=options?.catalogAmount ?? 499n
  const payment={id:'payment-1',status:'COMPLETED',orderId:'order-1',locationId:'test-location',customerId:'customer-1',amountMoney:{amount:499n,currency:'USD'}}
  const order={id:'order-1',locationId:'test-location',referenceId:`v_${checkoutId}`,tenders:[{paymentId:'payment-1'}]}
  const subscription={id:'sub-1',customerId:'customer-1',locationId:'test-location',planVariationId:'variation-1',status:'ACTIVE',chargedThroughDate:'2026-11-14'}
  const client={
    catalog:{object:{get:async request=>({catalogObject:{id:request.objectId,type:'SUBSCRIPTION_PLAN_VARIATION',subscriptionPlanVariationData:{phases:[{cadence:'MONTHLY',recurringPriceMoney:{amount:catalogAmount,currency:'USD'}}]}}})}},
    checkout:{paymentLinks:{create:async request=>{Object.assign(linkRequest,request);return {paymentLink:{id:'link-1',orderId:'order-1',url:'https://sandbox.square.link/u/test'}}}}},
    orders:{get:async request=>{calls.push(['order',request]);return {order}}},
    payments:{get:async request=>{calls.push(['payment',request]);return {payment}}},
    subscriptions:{search:async request=>{calls.push(['search',request]);return {subscriptions:[subscription]}},get:async request=>({subscription}),cancel:async request=>{calls.push(['cancel',request]);subscription.canceledDate='2026-11-14';return {subscription}}},
    invoices:{get:async request=>({invoice:{id:request.invoiceId,status:'PAID',locationId:'test-location',subscriptionId:'sub-1'}})},
  }
  const app=express(); app.use('/internal/veynor-premium',createVeynorPremiumRelay({env:{...env,...options?.env},getClient:()=>client}))
  const server=app.listen(0,'127.0.0.1'); await new Promise(resolve=>server.once('listening',resolve))
  const base=`http://127.0.0.1:${server.address().port}/internal/veynor-premium`
  async fn send(path,body,token=secret) { const response=await fetch(base+path,{method:body==undefined?'GET':'POST',headers:{Authorization:`Bearer ${token}`,'Content-Type':'application/json'},body:body==undefined?undefined:JSON.stringify(body)});return {status:response.status,value:await response.json()} }
  try { await action(send,{calls,linkRequest,payment,order,subscription}) } finally { await new Promise(resolve=>server.close(resolve)) }
}

test('relay is private, returns safe readiness, and uses only the fixed subscription plan and amount',async()=>{
 await withRelay({},async(send,ctx)=>{
   assert.equal((await send('/status',undefined,'wrong')).status,401)
   assert.deepEqual((await send('/status')).value,{enabled:true,environment:'sandbox',locationId:'test-location',planVariationId:'variation-1',amountCents:499})
   const result=await send('/link',{checkoutId,planId:'plus_monthly',amountCents:1,variationId:'attacker'})
   assert.equal(result.status,200)
   assert.equal(ctx.linkRequest.checkoutOptions.subscriptionPlanId,'variation-1')
   assert.equal(ctx.linkRequest.order.lineItems[0].basePriceMoney.amount,499n)
   assert.equal(ctx.linkRequest.order.referenceId,`v_${checkoutId}`)
   assert.equal(ctx.linkRequest.paymentNote.includes(checkoutId),true)
 })
})

test('relay refuses arbitrary offers and rejects mismatched checkout identifiers',async()=>{
 await withRelay({},async(send,ctx)=>{
   assert.equal((await send('/link',{checkoutId,planId:'studio'})).status,400)
   assert.equal((await send('/link',{checkoutId:'bad',planId:'plus_monthly'})).status,400)
   assert.deepEqual(ctx.linkRequest,{})
 })
})

test('relay verifies order reference, location and payment before exposing it',async()=>{
 await withRelay({},async(send,ctx)=>{
   const result=await send('/order-payment',{checkoutId,orderId:'order-1'})
   assert.equal(result.value.payment.customerId,'customer-1')
   assert.equal(result.value.payment.amountCents,499)
   const subs=await send('/subscriptions',{customerId:'customer-1'})
   assert.equal(subs.value.subscriptions[0].planVariationId,'variation-1')
   const canceled=await send('/cancel',{subscriptionId:'sub-1'})
   assert.equal(canceled.value.subscription.status,'ACTIVE')
   assert.equal(canceled.value.subscription.canceledDate,'2026-11-14')
   assert.equal((await send('/invoice',{invoiceId:'invoice-1'})).value.invoice.subscriptionId,'sub-1')
   ctx.order.referenceId='v_11111111-1111-4111-8111-111111111111'
   assert.equal((await send('/order-payment',{checkoutId,orderId:'order-1'})).status,503)
 })
})

test('a live dedicated Square account can be used without borrowing the 2am merchant',async()=>{
 await withRelay({env:{VEYNOR_PREMIUM_SQUARE_ENV:'production',VEYNOR_PREMIUM_RELAY_ENABLED:'1'}},async(send)=>{
   assert.equal((await send('/status')).status,200)
 })
})

test('relay fails closed when the actual Square catalog price differs from advertised pricing',async()=>{
 await withRelay({catalogAmount:599n},async(send)=>{
   assert.equal((await send('/status')).status,503)
 })
})

test('production relay cannot borrow the 2am merchant without explicit opt-in',async()=>{
 await withRelay({env:{VEYNOR_PREMIUM_SQUARE_ENV:'production',VEYNOR_PREMIUM_RELAY_ENABLED:'1',VEYNOR_PREMIUM_USE_2AM_SQUARE:'0',VEYNOR_PREMIUM_SQUARE_ACCESS_TOKEN:''}},async(send)=>{
   assert.equal((await send('/status')).status,503)
 })
})
