PRINTIFY_API_KEY=your_printify_api_key_here
PRINTIFY_SHOP_ID=1

# Payments — Square (developer.squareup.com). Create a sandbox app to get
# these three values before checkout will work; SQUARE_APPLICATION_ID is
# also baked into each frontend page's CONFIG block (it's client-safe,
# like a publishable key).
SQUARE_ACCESS_TOKEN=your_square_sandbox_access_token_here
SQUARE_APPLICATION_ID=your_square_application_id_here
SQUARE_LOCATION_ID=your_square_location_id_here
SQUARE_ENV=sandbox

# Private Probro Square relay. The relay has its own off switch and service
# secret; Sandbox uses a dedicated Sandbox token/location. For live Probro
# charges only, PROBRO_USE_2AM_SQUARE=1 explicitly permits reuse of the 2am
# production merchant client/location. Never set that switch for Sandbox.
PROBRO_PAYMENT_RELAY_ENABLED=0
PROBRO_PAYMENT_RELAY_SECRET=
PROBRO_SQUARE_ENV=sandbox
PROBRO_SQUARE_ACCESS_TOKEN=
PROBRO_SQUARE_LOCATION_ID=
PROBRO_USE_2AM_SQUARE=0
PROBRO_SITE_URL=https://probro.cc

# Veynor Plus Square subscription relay, separate from Probro and 2AM product sales.
VEYNOR_PREMIUM_RELAY_ENABLED=0
VEYNOR_PREMIUM_RELAY_SECRET=
VEYNOR_PREMIUM_SQUARE_ENV=sandbox
VEYNOR_PREMIUM_SQUARE_ACCESS_TOKEN=
VEYNOR_PREMIUM_SQUARE_LOCATION_ID=
VEYNOR_PREMIUM_USE_2AM_SQUARE=0
VEYNOR_PLUS_MONTHLY_VARIATION_ID=
VEYNOR_PLUS_MONTHLY_AMOUNT_CENTS=
VEYNOR_PLUS_PLAN_NAME=Veynor Plus
VEYNOR_PLUS_RETURN_URL=
# Cungus refuses checkout until this variation exists and every phase is
# indefinite monthly at the configured USD amount.

# Free Clikey gift on $100+ orders, plus fulfillment-failure/preorder alerts
# — where those get emailed. Blank STL still optional (backend/blanks/).
OWNER_EMAIL=chrisclm713@gmail.com
# SMTP sender account (e.g. a Gmail address with an App Password)
EMAIL_USER=your_sender_email_here
EMAIL_PASS=your_email_app_password_here

# Mambru unified backend — coupon validation + sales logging
MAMBRU_BACKEND_URL=http://localhost:4200
MAMBRU_API_KEY=your_mambru_shop_api_key_here

PORT=3000
