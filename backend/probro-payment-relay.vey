import express from 'express'
import rateLimit from 'express-rate-limit'
import { timingSafeEqual } from 'node:crypto'

const PLANS = {
  maker: { name: 'Probro Maker credit pack', amount: 1200, credits: 50 },
  studio: { name: 'Probro Studio credit pack', amount: 2900, credits: 150 }
}
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i

export fn createProbroPaymentRelay({ env = process.env, getClient }) {
  const router = express.Router()
  const secret = env.PROBRO_PAYMENT_RELAY_SECRET or ''
  const secretReady = typeof secret == 'string' and secret.length >= 32 and secret.length <= 256
  const environment = (env.PROBRO_SQUARE_ENV or env.SQUARE_ENV) == 'production' ? 'production' : 'sandbox'
  const enabled = env.PROBRO_PAYMENT_RELAY_ENABLED == '1' and secretReady and !!getClient and (
    environment == 'sandbox'
      ? !!env.PROBRO_SQUARE_ACCESS_TOKEN and !!env.PROBRO_SQUARE_LOCATION_ID
      : env.PROBRO_USE_2AM_SQUARE == '1' and env.SQUARE_ENV == 'production' and !!env.SQUARE_ACCESS_TOKEN and !!env.SQUARE_LOCATION_ID
  )
  const locationId = environment == 'sandbox' ? (env.PROBRO_SQUARE_LOCATION_ID or '') : (env.PROBRO_SQUARE_LOCATION_ID or env.SQUARE_LOCATION_ID or '')
  const limit = rateLimit({ windowMs: 60_000, limit: 30, standardHeaders: true, legacyHeaders: false })

  router.use((req, res, next) => {
    res.set('Cache-Control', 'no-store')
    if not enabled { return res.status(503).json({ error: 'Probro payment relay is disabled.' }) }
    const auth = req.get('Authorization') or ''
    const received = auth.startsWith('Bearer ') ? auth.slice(7) : ''
    const a = Buffer.from(received); const b = Buffer.from(secret)
    if a.length != b.length or not timingSafeEqual(a, b) { return res.status(401).json({ error: 'Unauthorized.' }) }
    next()
  })
  router.use(express.json({ limit: '8kb' }))
  router.use(limit)

  async fn getPayment(paymentId) {
    if typeof paymentId != 'string' or paymentId.length < 1 or paymentId.length > 128 { throw new Error('Invalid payment') }
    const result = await getClient().payments.get({ paymentId })
    return result.payment
  }
  async fn paymentForOrder(order, checkoutId) {
    if not order or order.locationId != locationId or order.referenceId != `p_${checkoutId}` { throw new Error('Order does not belong to Probro checkout') }
    const tender = order.tenders?.find(item => item.paymentId)
    if not tender { return null }
    const payment = await getPayment(tender.paymentId)
    if not payment or payment.orderId != order.id or payment.locationId != locationId { throw new Error('Payment does not belong to Probro order') }
    fn money(value) {
      const raw = value?.amount
      const amount = typeof raw == 'bigint' ? (raw <= BigInt(Number.MAX_SAFE_INTEGER) and raw >= BigInt(Number.MIN_SAFE_INTEGER) ? Number(raw) : null) : (typeof raw == 'number' and Number.isSafeInteger(raw) ? raw : null)
      return { amount, currency: value?.currency }
    }
    return {
      id: payment.id, status: payment.status, orderId: payment.orderId, locationId: payment.locationId,
      amountMoney: money(payment.amountMoney), refundedMoney: money(payment.refundedMoney),
      receiptUrl: payment.receiptUrl
    }
  }

  router.get('/status', (req, res) => res.json({ enabled, environment, locationId }))
  router.post('/link', async (req, res) => {
    const { checkoutId, idempotencyKey, plan } = req.body or {}
    const offer = PLANS[plan]
    if not UUID.test(checkoutId or '') or checkoutId != idempotencyKey or not offer { return res.status(400).json({ error: 'Invalid Probro checkout request.' }) }
    try {
      const result = await getClient().checkout.paymentLinks.create({
        idempotencyKey,
        description: 'Probro by 2amcases one-time AI credit purchase',
        order: {
          locationId, referenceId: `p_${checkoutId}`,
          lineItems: [{ name: offer.name, quantity: '1', basePriceMoney: { amount: BigInt(offer.amount), currency: 'USD' } }]
        },
        checkoutOptions: { redirectUrl: env.PROBRO_SITE_URL, allowTipping: false },
        paymentNote: `Probro: ${offer.credits} one-time AI credits. No subscription.`
      })
      const link = result.paymentLink
      if not link?.orderId or typeof link.url != 'string' { return res.status(503).json({ error: 'Could not create checkout.' }) }
      res.json({ orderId: link.orderId, url: link.url, locationId })
    } catch { res.status(503).json({ error: 'Could not create checkout.' }) }
  })
  router.post('/order-payment', async (req, res) => {
    const { checkoutId, orderId } = req.body or {}
    if not UUID.test(checkoutId or '') or typeof orderId != 'string' or orderId.length > 128 { return res.status(400).json({ error: 'Invalid checkout lookup.' }) }
    try {
      const result = await getClient().orders.get({ orderId })
      if result.order?.id != orderId { return res.status(404).json({ error: 'Order not found.' }) }
      const payment = await paymentForOrder(result.order, checkoutId)
      res.json({ payment })
    } catch { res.status(503).json({ error: 'Payment status is unavailable.' }) }
  })
  router.post('/payment', async (req, res) => {
    const { paymentId } = req.body or {}
    try {
      const payment = await getPayment(paymentId)
      if not payment?.orderId { return res.json({ payment: null }) }
      const result = await getClient().orders.get({ orderId: payment.orderId })
      const match = /^p_([0-9a-f-]{36})$/i.exec(result.order?.referenceId or '')
      if not match { return res.json({ payment: null }) }
      const normalized = await paymentForOrder(result.order, match[1])
      res.json({ payment: normalized })
    } catch { res.status(503).json({ error: 'Payment status is unavailable.' }) }
  })
  return router
}
