    variants: colors.flatMap(color => sizes.map(size => ({ id: `anc-${size.toLowerCase()}-${color.toLowerCase().replaceAll(' ', '-')}`, title: `${size} / ${color}`, price: 7000, is_enabled: true, is_available: true }))),
    tapstitch: {
      item: 'RQ0024',
