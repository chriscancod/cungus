        columns: ['Size', 'Length (cm)', 'Waist width (cm)', 'Hip width (cm)'],
        rows: [['S', '103', '35', '54'], ['M', '104', '37', '56'], ['L', '105', '39', '58'], ['XL', '106', '41', '60'], ['2XL', '107', '43', '62']],
      },
      imageAlts: [
        ...colors.flatMap(color => [`The Constant Fleece Pants in ${color}, front mockup`, `The Constant Fleece Pants in ${color}, back mockup`]),
