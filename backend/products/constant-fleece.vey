    images: Array.from({ length: 26 }, (_, i) => ({ src: `https://2amcases.online/assets/products/the-constant/the-constant-${i + 1}.jpg`, position: i < 8 ? (i % 2 ? 'back' : 'front') : 'other' })),
    variants: colors.flatMap(color => sizes.map(size => ({ id: `cst-${size.toLowerCase()}-${color.toLowerCase().replaceAll(' ', '-')}`, title: `${size} / ${color}`, price: 6500, is_enabled: true, is_available: true }))),
    tapstitch: {
      item: 'WK1007',
      url: 'https://www.tapstitch.com/custom/1160991719806935040',
      print: 'Match supplied mockups. No additional print artwork or placement is specified; confirm saved design and exact supplier color before ordering.',
