// TapStitch RW0029 specifications verified 2026-10-12.
const colors = ['Black', 'Light Gray']
const sizes = ['S', 'M', 'L', 'XL', '2XL', '3XL']
export fn makeStillwaterCrewneck(care, shipReturns) {
  return {
    id: '2am-the-stillwater',
    title: 'The Stillwater Crewneck Sweatshirt',
    description: 'A heavyweight crewneck for the daily rotation. Loose fit, drop shoulders and long sleeves, in a 400 gsm polyester-cotton-spandex blend. Black or light gray. S–3XL.',
    tags: ['tapstitch', 'showfloor'],
    blueprint_id: null,
    published: true,
    launchAt: null,
    created_at: '2026-10-12T19:30:00.000Z',
    images: Array.from({ length: 20 }, (_, i) => ({ src: `https://2amcases.online/assets/products/the-stillwater/the-stillwater-${i + 1}.jpg`, position: i < 4 ? (i % 2 ? 'back' : 'front') : 'other' })),
    variants: colors.flatMap(color => sizes.map(size => ({ id: `stw-${size.toLowerCase()}-${color.toLowerCase().replaceAll(' ', '-')}`, title: `${size} / ${color}`, price: 6500, is_enabled: true, is_available: true }))),
    tapstitch: {
      item: 'RW0029',
      url: 'https://www.tapstitch.com/custom/1426212872358387712',
      print: 'Match supplied product mockups. No additional print artwork or placement is specified; confirm the saved design and supplier color before ordering.',
      colors: {},
    },
    content: {
      paragraphs: [
        'A substantial crewneck for the quiet hours and the everyday work between them. The loose unisex cut, dropped shoulders and long sleeves make it an easy layer over a tee.',
        'The main fabric is 48.9% polyester, 43.4% cotton and 7.7% spandex, weighing 400 gsm (11.8 oz/yd²). TapStitch separately lists the contrast fabric as 95.6% polyester and 4.4% spandex. This is a blended-fabric sweatshirt, not a pure-cotton garment.',
        'Black and light gray mockups show the offered colorways. Navy model photos and green close-ups illustrate fit and construction only; those colors are not currently offered. Small shade and finish differences between batches are normal. Compare the supplier’s garment measurements with a sweatshirt you own before choosing a size.',
      ],
      specs: [
        ['Main fabric', '48.9% polyester, 43.4% cotton, 7.7% spandex. 400 gsm (11.8 oz/yd²).'],
        ['Contrast fabric', '95.6% polyester, 4.4% spandex, as listed by TapStitch.'],
        ['Fit', 'Loose unisex cut with drop shoulders. S–3XL.'],
        ['Construction', 'Round crew neckline and long sleeves.'],
        ['Colors', 'Black and light gray. Navy and green gallery images are references only.'],
      ],
      care,
      shipReturns,
      sizeChart: {
        note: 'Loose fit, S–3XL. Consult the RW0029 size guide on TapStitch and compare garment measurements with a sweatshirt you own before ordering. Exact garment measurements have not been verified for this page.',
        columns: ['Available sizes'],
        rows: sizes.map(size => [size]),
      },
      imageAlts: [
        ...colors.flatMap(color => [`The Stillwater Crewneck Sweatshirt in ${color.toLowerCase()}, front mockup`, `The Stillwater Crewneck Sweatshirt in ${color.toLowerCase()}, back mockup`]),
        ...['front', 'side', 'three-quarter front', 'back', 'hands in pockets'].map(view => `Model wearing the light gray RW0029 sweatshirt, ${view} fit reference`),
        ...['front', 'side', 'walking', 'back', 'three-quarter front'].map(view => `Model wearing the navy RW0029 sweatshirt, ${view}; fit reference only, navy not offered`),
        ...['crew collar', 'cuff', 'hem', 'back neckline', 'fabric drape', 'fabric texture'].map(detail => `Green RW0029 ${detail} detail; construction reference only, green not offered`),
      ],
    },
  }
}
