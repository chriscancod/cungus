// UT0319 verified directly against TapStitch's product page, 2026-10-12.
const colors = ['Black', 'White Gray', 'Oat Gray', 'Heather Gray', 'Coffee Brown']
const sizes = ['XS', 'S', 'M', 'L', 'XL', '2XL']
export fn makeIntervalQuarterZip(care, shipReturns) {
  return {
    id: '2am-the-interval',
    title: 'The Interval Quarter-Zip Sweatshirt',
    description: 'A boxy quarter-zip for the daily rotation. 350 gsm, loose unisex fit, long sleeves and ribbed cuffs and hem. Five colorways. XS–2XL.',
    tags: ['tapstitch', 'showfloor'],
    blueprint_id: null,
    published: true,
    launchAt: null,
    created_at: '2026-10-12T20:10:00.000Z',
    images: Array.from({ length: 28 }, (_, i) => ({ src: `https://2amcases.online/assets/products/the-interval/the-interval-${i + 1}.jpg`, position: i < 10 ? (i % 2 ? 'back' : 'front') : 'other' })),
    variants: colors.flatMap(color => sizes.map(size => ({ id: `int-${size.toLowerCase()}-${color.toLowerCase().replaceAll(' ', '-')}`, title: `${size} / ${color}`, price: 6500, is_enabled: true, is_available: true }))),
    tapstitch: {
      item: 'UT0319',
      url: 'https://www.tapstitch.com/custom/1542136699621179392',
      print: 'Match supplied mockups. No additional print artwork or placement is specified; confirm the saved design before ordering.',
      colors: { 'Heather Gray': 'Flower Gray', 'Coffee Brown': 'Coffee' },
    },
    content: {
      paragraphs: [
        'A considered layer for the time between work and rest. The quarter-zip neckline and collar give it a clean finish; the loose, boxy shape and shorter body keep it relaxed. Ribbed cuffs and hem complete the silhouette.',
        'The outer fabric is 61% cotton and 39% polyester; the inner fabric is 100% polyester. TapStitch lists the weight at 350 gsm (10.3 oz/yd²). Minor shade and finish differences between production batches are normal.',
        'The gallery shows all five colorways, model fit references and close-ups of the collar, cuffs, hem and fabric. Compare the supplier’s garment measurements with a sweatshirt you own before choosing a size.',
      ],
      specs: [
        ['Outer fabric', '61% cotton, 39% polyester. 350 gsm (10.3 oz/yd²).'],
        ['Inner fabric', '100% polyester.'],
        ['Fit', 'Loose boxy unisex silhouette with a short body. XS–2XL.'],
        ['Construction', 'Collar, quarter-zip neckline, long sleeves, ribbed cuffs and hem.'],
        ['Colors', 'Black, white gray, oat gray, heather gray and coffee brown.'],
      ],
      care,
      shipReturns,
      sizeChart: {
        note: 'Boxy fit with a short body, XS–2XL. Consult the UT0319 size guide on TapStitch and compare garment measurements with a sweatshirt you own before ordering. Exact measurements have not been verified for this page.',
        columns: ['Available sizes'],
        rows: sizes.map(size => [size]),
      },
      imageAlts: [
        ...colors.flatMap(color => [`The Interval Quarter-Zip Sweatshirt in ${color.toLowerCase()}, front mockup`, `The Interval Quarter-Zip Sweatshirt in ${color.toLowerCase()}, back mockup`]),
        'UT0319 coffee brown quarter-zip, front reference', 'UT0319 coffee brown quarter-zip, back reference',
        ...['front', 'side', 'three-quarter front', 'back', 'hands in pockets'].map(view => `Model wearing the coffee brown UT0319 quarter-zip, ${view} fit reference`),
        ...['front', 'side', 'three-quarter front', 'back', 'three-quarter back'].map(view => `Model wearing the oat gray UT0319 quarter-zip, ${view} fit reference`),
        ...['collar and zipper', 'cuff', 'hem', 'back collar', 'fabric drape', 'fabric texture'].map(detail => `UT0319 oat gray quarter-zip ${detail} detail`),
      ],
    },
  }
}
