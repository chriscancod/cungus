// TapStitch PL0005 specs verified 2026-10-12. Retail price confirmed: $50.
const colors = ['White', 'Black', 'Cream', 'Purple', 'Navy']
const sizes = ['S', 'M', 'L', 'XL', '2XL', '3XL']
const images = Array.from({ length: 18 }, (_, i) => ({ src: `https://2amcases.online/assets/products/the-steady/the-steady-${i + 1}.jpg`, position: i < 10 ? (i % 2 ? 'back' : 'front') : 'other' }))
const variants = colors.flatMap(color => sizes.map(size => ({ id: `stdy-${size.toLowerCase()}-${color.toLowerCase()}`, title: `${size} / ${color}`, price: 5000, is_enabled: true, is_available: true })))
export fn makeSteadyPolo(care, shipReturns) {
  return {
    id: '2am-the-steady',
    title: 'The Steady Polo',
    description: 'An everyday polo with a loose fit, drop shoulders and a two-button collar. 250 gsm polyester-cotton-spandex blend. White, black, cream, purple or navy. S–3XL.',
    tags: ['tapstitch', 'showfloor'],
    blueprint_id: null,
    published: true,
    launchAt: null,
    created_at: '2026-10-12T15:30:00.000Z',
    images,
    variants,
    tapstitch: {
      item: 'PL0005',
      url: 'https://www.tapstitch.com/custom/pl0005-drop-shoulder-short-sleeve-polo',
      print: 'Match the supplied mockups. No additional print artwork or placement is specified. Confirm the saved design and supplier color before placing the order.',
      colors: {},
    },
    content: {
      paragraphs: [
        'An easy polo for the daily rotation. The loose unisex cut, dropped shoulders and short sleeves give it a relaxed silhouette; the two-button collar keeps the finish considered. Wear it on its own or under a layer.',
        'The fabric is 50.5% polyester, 43.3% cotton and 6.2% spandex, weighing 250 gsm (7.4 oz/yd²). TapStitch describes the stretch as medium. Small shade and finish differences between production batches are normal.',
        'The gallery shows the five offered colorways from the front and back, plus close-ups of the collar, placket, sleeves and fabric. Check the supplier’s garment measurements against a polo you own before choosing a size.',
      ],
      specs: [
        ['Fabric', '50.5% polyester, 43.3% cotton, 6.2% spandex. 250 gsm (7.4 oz/yd²).'],
        ['Fit', 'Loose unisex cut, drop shoulders and short sleeves. S–3XL.'],
        ['Construction', 'Polo collar with a two-button placket.'],
        ['Stretch', 'Medium stretch, as described by TapStitch.'],
        ['Colors', 'White, black, cream, purple and navy, shown in the supplied mockups.'],
      ],
      care,
      shipReturns,
      sizeChart: {
        note: 'Loose fit, S–3XL. Consult the Steady garment size guide on TapStitch and compare with a polo you own before ordering. Exact garment measurements have not been verified for this page.',
        columns: ['Available sizes'],
        rows: sizes.map(size => [size]),
