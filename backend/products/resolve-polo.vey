// TapStitch RW0019 specifications checked 2026-10-12.
const colors = ['Black', 'Cream', 'Heather Gray', 'Charcoal', 'Navy']
const sizes = ['S', 'M', 'L', 'XL', '2XL']
export fn makeResolvePolo(care, shipReturns) {
  return {
    id: '2am-the-resolve',
    title: 'The Resolve Fleece Polo Sweatshirt',
    description: 'A heavyweight fleece polo sweatshirt with a loose cut, dropped shoulders and long sleeves. 445 gsm, 65% cotton / 35% polyester. Five colorways. S–2XL.',
    tags: ['tapstitch', 'showfloor'],
    blueprint_id: null,
    published: true,
    launchAt: null,
    created_at: '2026-10-12T19:50:00.000Z',
    images: Array.from({ length: 23 }, (_, i) => ({ src: `https://2amcases.online/assets/products/the-resolve/the-resolve-${i + 1}.jpg`, position: i < 10 ? (i % 2 ? 'back' : 'front') : 'other' })),
    variants: colors.flatMap(color => sizes.map(size => ({ id: `rsv-${size.toLowerCase()}-${color.toLowerCase().replaceAll(' ', '-')}`, title: `${size} / ${color}`, price: 7000, is_enabled: true, is_available: true }))),
    tapstitch: {
      item: 'RW0019',
      url: 'https://www.tapstitch.com/custom/1409954123910176768',
      print: 'Match the supplied mockups. No additional print artwork or placement is specified. Confirm the saved design and supplier color before ordering.',
      colors: {},
    },
    content: {
      paragraphs: [
        'A fleece layer with a polo collar: considered enough to wear on its own, relaxed enough for the daily rotation. The loose men’s cut has dropped shoulders and long sleeves.',
        'The fabric weighs 445 gsm (13.1 oz/yd²) and blends 65% cotton with 35% polyester. The gallery shows all five offered colorways, model fit references and close-ups of the collar, cuffs, hem and fabric. Minor differences in shade and finish between batches are normal.',
        'TapStitch lists the model at 187 cm / 6 ft 2 in, 74 kg / 163 lb, wearing 2XL. Compare garment measurements with a sweatshirt you own before choosing a size.',
      ],
      specs: [
        ['Fabric', '65% cotton, 35% polyester. Heavyweight fleece, 445 gsm (13.1 oz/yd²).'],
        ['Fit', 'Loose men’s cut with drop shoulders. S–2XL.'],
        ['Construction', 'Polo collar, button placket and long sleeves.'],
        ['Colors', 'Black, cream, heather gray, charcoal and navy, as pictured in the supplied mockups.'],
      ],
      care,
      shipReturns,
      sizeChart: {
        note: 'Loose fit, S–2XL. Consult the RW0019 garment size guide on TapStitch and compare with a sweatshirt you own before ordering. Exact garment measurements have not been verified for this page.',
        columns: ['Available sizes'],
        rows: sizes.map(size => [size]),
      },
      imageAlts: [
        ...colors.flatMap(color => [`The Resolve Fleece Polo Sweatshirt in ${color.toLowerCase()}, front mockup`, `The Resolve Fleece Polo Sweatshirt in ${color.toLowerCase()}, back mockup`]),
        'RW0019 charcoal fleece polo, front reference', 'RW0019 charcoal fleece polo, back reference',
        ...['front', 'hands in pockets', 'back', 'side', 'three-quarter front'].map(view => `Model wearing the black RW0019 fleece polo, ${view} fit reference`),
        ...['collar and placket', 'sleeve cuff', 'hem', 'back collar', 'fabric drape', 'fabric texture'].map(detail => `RW0019 charcoal fleece polo ${detail} detail`),
      ],
    },
  }
}
