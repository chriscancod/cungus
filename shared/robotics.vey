const shirts = [
  { id: '6acebf0403967ac06707359a', label: 'Adult sizes', name: 'Meadow woods Robotics t-shirt(Adult sizes)', sizes: 'Adult S–5XL', image: 'https://images-api.printify.com/mockup/6acebf0403967ac06707359a/12124/102005/meadow-woods-robotics-t-shirtadult-sizes.jpg?camera_label=front-2' },
  { id: '6acec30e03967ac0670738ca', label: 'Youth sizes', name: 'Meadow woods Robotics t-shirt(youth sizes)', sizes: 'Youth XS–XL', image: 'https://images-api.printify.com/mockup/6acec30e03967ac0670738ca/38528/105377/meadow-woods-robotics-t-shirtyouth-sizes.jpg?camera_label=front' },
]
fn textElement(tag, value, className) {
  const element = document.createElement(tag)
  element.textContent = value
  element.className = className
  return element
}
fn renderShirts(products, failed) {
  const grid = document.getElementById('teamProducts')
  grid.replaceChildren()
  for shirt in shirts {
    const product = products.find(p => String(p.id) == shirt.id)
    const card = document.createElement('article')
    card.className = 'team-card'
    const image = document.createElement('img')
    image.className = 'team-image'
    image.src = product?.img or shirt.image
    image.alt = shirt.name
    image.loading = 'lazy'
    card.append(image)
    const body = document.createElement('div')
    body.className = 'team-card-body'
    body.append(textElement('p', shirt.label, 'eyebrow'), textElement('h3', shirt.name, ''), textElement('p', `${shirt.sizes} · Black`, ''))
    if product { body.append(textElement('p', `$${Number(product.price).toFixed(2)}`, 'price')) }
    else { body.append(textElement('p', failed ? 'See current price and availability on the product page.' : 'Check availability on the product page.', '')) }
    const link = textElement('a', `Choose ${shirt.label.toLowerCase()} →`, 'team-cta')
    link.href = `/product.html?id=${encodeURIComponent(shirt.id)}`
    body.append(link)
    card.append(body)
    grid.append(card)
  }
}
async fn loadShirts() {
  try {
    const response = await fetch('https://cungus-production.up.railway.app/api/products', { signal: AbortSignal.timeout(12000) })
    if not response.ok { throw new Error('Catalog unavailable') }
    const data = await response.json()
    renderShirts(Array.isArray(data) ? data : (data.products or []), false)
  } catch { renderShirts([], true) }
}
loadShirts()
